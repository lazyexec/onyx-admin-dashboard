{
	"name": "onyx-admin-dashboard",
	"version": "0.1.0",
	"private": true,
	"packageManager": "pnpm@11.22.0",
	"dependencies": {
		"@supabase/ssr": "^0.12.7",
		"@supabase/supabase-js": "^2.116.0",
		"@vinext/cloudflare": "latest",
		"lucide-react": "^1.46.0",
		"react": "latest",
		"react-dom": "latest",
		"react-server-dom-webpack": "latest",
		"vinext": "latest"
	},
	"devDependencies": {
		"@cloudflare/vite-plugin": "latest",
		"@tailwindcss/postcss": "latest",
		"@types/node": "latest",
		"@types/react": "latest",
		"@types/react-dom": "latest",
		"@vitejs/plugin-react": "latest",
		"@vitejs/plugin-rsc": "latest",
		"tailwindcss": "latest",
		"typescript": "latest",
		"vite": "latest",
		"wrangler": "latest"
	},
	"type": "module",
	"scripts": {
		"dev": "vinext dev -p 3002",
		"build": "vinext build",
		"start": "wrangler dev --config dist/server/wrangler.json",
		"deploy": "vinext-cloudflare deploy --config dist/server/wrangler.json",
		"preview": "pnpm run build && pnpm run start",
		"cf-typegen": "wrangler types --env-interface CloudflareEnv ./worker-configuration.d.ts"
	}
}
